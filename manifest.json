{
  "manifest_version": 3,
  "name": "Threads AI 帳號標記",
  "version": "0.1.0",
  "description": "依本機維護的名單，在 Threads 上標記可能由 AI 生成的帳號。",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.threads.com/*", "https://threads.com/*"],
      "js": ["account-list.js", "threads-profile-api.js", "profile-location.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["threads_list.txt"],
      "matches": ["https://www.threads.com/*", "https://threads.com/*"]
    }
  ],
  "action": {
    "default_title": "Threads AI 帳號標記",
    "default_popup": "popup.html"
  }
}

{
  "manifest_version": 3,
  "name": "Threads AI 帳號標記",
  "version": "0.1.0",
  "description": "依本機維護的名單，在 Threads 上標記可能由 AI 生成的帳號。",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.threads.com/*", "https://threads.com/*"],
      "js": [
        "shared/account-list.js",
        "content/threads-profile-api.js",
        "content/profile-location.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/threads_list.txt"],
      "matches": ["https://www.threads.com/*", "https://threads.com/*"]
    }
  ],
  "action": {
    "default_title": "Threads AI 帳號標記",
    "default_popup": "popup/popup.html"
  }
}
